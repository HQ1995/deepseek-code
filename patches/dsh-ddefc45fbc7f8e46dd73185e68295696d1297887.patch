@@ -0,0 +1,91 @@
+/** Darwin 64-bit kernel process observations through the same sysctl used by ps. */
+
+import koffi from 'koffi'
+
+/** Fields needed by the local terminal inspector; identities retain second precision. */
+export interface MacProcessRow {
+  pid: number
+  parentPid: number
+  started: string
+  tpgid: number
+}
+
+/** Injectable sysctl call and its immediately captured errno. */
+export interface MacProcessTableInternals {
+  sysctl(mib: Int32Array, buffer: Buffer | null, size: Buffer): number
+  errno(): number
+}
+
+// Darwin's LP64 kinfo_proc layout (sys/sysctl.h and sys/proc.h), shared by
+// arm64 and x64. The native SDK oracle pins every consumed offset and size.
+const RECORD_BYTES = 648
+let nativeSysctl: ((mib: Int32Array, length: number, buffer: Buffer | null,
+  size: Buffer, replacement: null, replacementBytes: number) => number) | undefined
+
+/* v8 ignore start -- thin ABI binding, exercised by the macOS SDK/real-process test. */
+const DEFAULT_INTERNALS: MacProcessTableInternals = {
+  sysctl(mib, buffer, size) {
+    if (nativeSysctl === undefined) {
+      if (process.platform !== 'darwin' || !['arm64', 'x64'].includes(process.arch)) {
+        throw new Error('subprocess-local: kernel process inspection requires 64-bit macOS')
+      }
+      const libc = koffi.load('/usr/lib/libSystem.B.dylib')
+      nativeSysctl = libc.func('int sysctl(const int *name, unsigned int namelen, void *oldp, void *oldlenp, void *newp, size_t newlen)')
+    }
+    return nativeSysctl(mib, mib.length, buffer, size, null, 0)
+  },
+  errno: () => koffi.errno(),
+}
+/* v8 ignore stop */
+
+/**
+ * Read one complete kernel process observation, or throw on a failed/partial read.
+ * No observations or native buffers survive this call. Buffer capacity doubles
+ * the size observation to allow process creation between the two sysctl calls;
+ * growth beyond that capacity fails instead of accepting a truncated table.
+ *
+ * @param pid - select one PID, or omit for the entire process table.
+ * @param internals - injectable synchronous kernel operations.
+ * @returns Observed process rows, empty only for an absent selected PID.
+ */
+export function readMacProcessTable(
+  pid?: number,
+  internals: MacProcessTableInternals = DEFAULT_INTERNALS,
+): MacProcessRow[] {
+  // CTL_KERN / KERN_PROC / KERN_PROC_ALL or KERN_PROC_PID.
+  const mib = new Int32Array([1, 14, pid === undefined ? 0 : 1, pid ?? 0])
+  const size = Buffer.alloc(8)
+  const query = (buffer: Buffer | null): number => {
+    size.writeBigUInt64LE(BigInt(buffer?.length ?? 0))
+    if (internals.sysctl(mib, buffer, size) !== 0) {
+      throw new Error(`subprocess-local: macOS process query failed (errno ${internals.errno()})`)
+    }
+    const bytes = Number(size.readBigUInt64LE())
+    if (!Number.isSafeInteger(bytes) || bytes % RECORD_BYTES !== 0
+      || (buffer !== null && bytes > buffer.length)
+      || (pid === undefined && bytes === 0)) {
+      throw new Error('subprocess-local: invalid macOS process table byte count')
+    }
+    return bytes
+  }
+  const capacity = query(null)
+  if (capacity === 0) return []
+  const buffer = Buffer.alloc(capacity * 2)
+  const bytes = query(buffer)
+  const rows: MacProcessRow[] = []
+  for (let offset = 0; offset < bytes; offset += RECORD_BYTES) {
+    const processId = buffer.readInt32LE(offset + 40)
+    // kernel_task is not a signal target in ps either.
+    if (processId === 0 && (pid === undefined || pid === 0)) continue
+    const parentPid = buffer.readInt32LE(offset + 560)
+    const started = buffer.readBigInt64LE(offset)
+    if (processId < 0 || parentPid < 0 || started < 0n || (pid !== undefined && processId !== pid)) {
+      throw new Error('subprocess-local: invalid macOS process table record')
+    }
+    rows.push({ pid: processId, parentPid, started: String(started), tpgid: buffer.readInt32LE(offset + 576) })
+  }
+  if (pid === undefined && rows.length === 0) {
+    throw new Error('subprocess-local: empty macOS process table')
+  }
+  return rows
+}
