+/* SDK oracle for the LP64 fields consumed by mac-process-table.ts. */
+#include <stddef.h>
+#include <sys/types.h>
+#include <sys/sysctl.h>
+#include <sys/proc.h>
+_Static_assert(sizeof(size_t) == 8, "size_t");
+_Static_assert(sizeof(struct kinfo_proc) == 648, "kinfo_proc stride");
+_Static_assert(offsetof(struct kinfo_proc, kp_proc.p_starttime.tv_sec) == 0, "start seconds");
+_Static_assert(sizeof(((struct kinfo_proc *)0)->kp_proc.p_starttime.tv_sec) == 8, "start width");
+_Static_assert(offsetof(struct kinfo_proc, kp_proc.p_pid) == 40, "pid offset");
+_Static_assert(sizeof(pid_t) == 4, "pid width");
+_Static_assert(offsetof(struct kinfo_proc, kp_eproc.e_ppid) == 560, "parent offset");
