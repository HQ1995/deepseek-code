+type LoadedProfile = ReturnType<typeof loadProfileDirectory>
+
+/** Whether a profile patch supplies this entry's own configuration. */
+const ownsConfig = (patch: PatchOptions, id: string): boolean =>
+  patch.id === id && patch.insert === undefined && Object.hasOwn(patch, 'config')
+
+/**
+ * Inherited configuration per entry id: every layer and profile patch except
+ * the entry's own profile configuration. Removing a config key the entry's
+ * patches do not carry leaves the patch list unchanged, so every entry without
+ * its own profile configuration shares one composition; only entries with one
+ * compose separately. Returned values are detached.
+ * @param loaded Profile layers and patches read for one configuration pass.
+ * @returns Resolver from entry id to its inherited configuration.
+ */
+function inheritedConfigs(loaded: LoadedProfile): (id: string) => Record<string, unknown> {
+  const layers = loaded.layers.map(layer => layer.patches)
+  const compose = (patches: PatchOptions[]): Map<string, EntryOptions> => {
+    const rows = new Map<string, EntryOptions>()
+    for (const row of flatten(composeEntries([...layers, patches]))) {
+      if (row.id !== undefined && !rows.has(row.id)) rows.set(row.id, row)
+    }
+    return rows
+  }
+  let shared: Map<string, EntryOptions> | undefined
+  return (id) => {
+    const rows = loaded.patches.some(patch => ownsConfig(patch, id))
+      ? compose(loaded.patches.map((patch) => {
+        if (!ownsConfig(patch, id)) return patch
+        const rest = { ...patch }; Reflect.deleteProperty(rest, 'config')
+        return rest
+      }))
+      : shared ??= compose(loaded.patches)
+    return structuredClone((rows.get(id)?.config ?? {}) as Record<string, unknown>)
+  }
+}
