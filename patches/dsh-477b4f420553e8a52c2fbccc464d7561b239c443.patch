+/** A reminder whose Session could not be resolved when it fell due is retried when the host requests delivery. */
+import type { Context } from '@deepseek-ai/cordis'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import { agentFor, harness } from './harness.ts'
+
+const contexts: Context[] = []
+beforeEach(() => { vi.useFakeTimers(); vi.setSystemTime(new Date('2026-09-16T00:00:00Z')) })
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  vi.useRealTimers()
+})
+
+it('delivers a reminder that failed to resolve its Session only after requestDelivery', async () => {
+  const test = await harness({ onContext: ctx => contexts.push(ctx) })
+  const agent = agentFor(test.ctx)
+  const record = await test.service.create(agent.session.id, { prompt: 'Stand up', after_seconds: 60, title: 'Stand up' })
+  // The Session cannot be resolved: the due reminder fails and leaves the timer.
+  await vi.advanceTimersByTimeAsync(60_000)
+  expect(test.resolve).toHaveBeenCalledOnce()
+  expect(vi.getTimerCount()).toBe(0)
+  // The Session becomes resolvable; nothing retries until the host asks.
+  test.resolve.mockResolvedValue({ agent })
+  await vi.advanceTimersByTimeAsync(3_600_000)
+  expect(test.resolve).toHaveBeenCalledOnce()
+  expect(agent.followup).not.toHaveBeenCalled()
+  test.service.requestDelivery()
+  await vi.advanceTimersByTimeAsync(0)
+  expect(test.resolve).toHaveBeenCalledTimes(2)
+  expect(agent.followup).toHaveBeenCalledOnce()
+  expect(await test.service.list({ sessionId: agent.session.id })).toEqual([])
+  expect((await test.service.catalog()).find(entry => entry.id === record.id)?.status).toBe('inactive')
+})
