+import { createProcessInspector } from '@deepseek-ai/dsh-subprocess-local/src/process-inspector.ts'
+
+function record(pid: number, parentPid = 1, started = 500n, tpgid = -1): Buffer {
+  const bytes = Buffer.alloc(648)
+  bytes.writeBigInt64LE(started, 0)
+  bytes.writeInt32LE(pid, 40)
+  bytes.writeInt32LE(parentPid, 560)
+  bytes.writeInt32LE(tpgid, 576)
+  return bytes
+}
+
+function fakeTable(records = [record(10)], estimatedBytes = records.length * 648) {
+  const calls: Array<{ mib: number[]; capacity: number }> = []
+  const internals: MacProcessTableInternals = {
+    sysctl(mib, buffer, size) {
+      calls.push({ mib: Array.from(mib), capacity: Number(size.readBigUInt64LE()) })
+      if (buffer === null) size.writeBigUInt64LE(BigInt(estimatedBytes))
+      else {
+        const bytes = Buffer.concat(records)
+        bytes.copy(buffer)
+        size.writeBigUInt64LE(BigInt(bytes.length))
+      }
+      return 0
+    },
+    errno: () => 12,
+  }
+  return { internals, calls }
+}
+
+describe('macOS kernel process table', () => {
+  it('reads full tables and selected identities without sharing observations', () => {
+    const fake = fakeTable([record(0, 0), record(10, 1, 500n, 55), record(11, 10, 501n)])
+    expect(readMacProcessTable(undefined, fake.internals)).toEqual([
+      { pid: 10, parentPid: 1, started: '500', tpgid: 55 },
+      { pid: 11, parentPid: 10, started: '501', tpgid: -1 },
+    ])
+    expect(fake.calls).toEqual([{ mib: [1, 14, 0, 0], capacity: 0 }, { mib: [1, 14, 0, 0], capacity: 3888 }])
+    const selected = fakeTable([record(11, 10, 501n)])
+    expect(readMacProcessTable(11, selected.internals)[0]?.started).toBe('501')
+    expect(selected.calls).toEqual([{ mib: [1, 14, 1, 11], capacity: 0 }, { mib: [1, 14, 1, 11], capacity: 1296 }])
+    const changed = fakeTable([record(11, 10, 502n)])
+    selected.internals.sysctl = changed.internals.sysctl.bind(changed.internals)
+    expect(readMacProcessTable(11, selected.internals)[0]?.started).toBe('502')
+  })
+
+  it('accepts bounded table growth and returns only bytes actually written', () => {
+    const growth = fakeTable([record(10), record(11)], 648)
+    expect(readMacProcessTable(undefined, growth.internals)).toHaveLength(2)
+    const shrink = fakeTable([record(10)], 648 * 3)
+    expect(readMacProcessTable(undefined, shrink.internals)).toHaveLength(1)
+  })
+
+  it('distinguishes a selected PID disappearing from an empty full observation', () => {
+    const absent = fakeTable([])
+    expect(readMacProcessTable(11, absent.internals)).toEqual([])
+    expect(absent.calls).toHaveLength(1)
+    expect(readMacProcessTable(11, fakeTable([], 648).internals)).toEqual([])
+    expect(() => readMacProcessTable(undefined, absent.internals)).toThrow('byte count')
+    expect(() => readMacProcessTable(undefined, fakeTable([], 648).internals)).toThrow('byte count')
+    expect(() => readMacProcessTable(undefined, fakeTable([record(0, 0)]).internals)).toThrow('empty macOS process table')
+    expect(readMacProcessTable(0, fakeTable([record(0, 0)]).internals)).toEqual([])
+  })
+
+  it('propagates sizing/read errors, including growth beyond allocated capacity', () => {
+    for (const failSizing of [true, false]) {
+      const fake = fakeTable()
+      const query = fake.internals.sysctl.bind(fake.internals)
+      fake.internals.sysctl = (mib, buffer, size) => (buffer === null) === failSizing ? -1 : query(mib, buffer, size)
+      expect(() => readMacProcessTable(10, fake.internals)).toThrow('errno 12')
+    }
+    expect(() => readMacProcessTable(undefined, fakeTable([record(10), record(11), record(12)], 648).internals)).toThrow('byte count')
+  })
+
+  it('rejects malformed byte counts and invalid/mismatched records', () => {
+    for (const count of [1n, 647n, 649n, 18446744073709551615n]) {
+      const fake = fakeTable()
+      fake.internals.sysctl = (_mib, _buffer, size) => { size.writeBigUInt64LE(count); return 0 }
+      expect(() => readMacProcessTable(10, fake.internals)).toThrow('byte count')
+    }
+    for (const bytes of [record(-1), record(10, -1), record(10, 1, -1n), record(11), record(0)]) {
+      expect(() => readMacProcessTable(10, fakeTable([bytes]).internals)).toThrow('record')
+    }
+  })
+
+  it.skipIf(process.platform !== 'darwin')('matches both SDK architectures and ps for live/absent processes across user identities', async () => {
+    const oracle = fileURLToPath(new URL('./mac-process-layout.c', import.meta.url))
+    for (const arch of ['arm64', 'x86_64']) execFileSync('/usr/bin/cc', ['-arch', arch, '-fsyntax-only', oracle])
+    const child = spawn('/bin/sleep', ['30'], { stdio: 'ignore' })
+    const exited = once(child, 'exit')
+    const inspector = createProcessInspector()
+    try {
+      expect(child.pid).toBeDefined()
+      const full = readMacProcessTable()
+      for (const pid of [1, process.pid, child.pid!]) {
+        const row = readMacProcessTable(pid)[0]
+        expect(row).toBeDefined()
+        expect(full.find(entry => entry.pid === pid)).toEqual(row)
+        const ps = execFileSync('/bin/ps', ['-p', String(pid), '-o', 'ppid=,lstart='], {
+          encoding: 'utf8', env: { PATH: '/usr/bin:/bin', LC_ALL: 'C', TZ: 'UTC' },
+        }).trim().match(/^(\d+)\s+(.+)$/)
+        expect(row?.parentPid).toBe(Number(ps?.[1]))
+        expect(row?.started).toBe(String(Date.parse(`${ps?.[2]} UTC`) / 1000))
+      }
+      const identity = inspector.snapshot().tree(child.pid!).find(row => row.pid === child.pid)
+      expect(identity).toBeDefined()
+      expect(inspector.isAlive(identity!)).toBe(true)
+      inspector.signalProcess({ ...identity!, started: 'not this process' }, 'SIGKILL')
+      expect(inspector.isAlive(identity!)).toBe(true)
+    } finally {
+      child.kill('SIGTERM')
+      await exited
+    }
+    expect(readMacProcessTable(child.pid)).toEqual([])
+  }, 30000)
+})
