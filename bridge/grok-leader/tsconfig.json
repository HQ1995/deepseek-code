{
  // Out-of-tree build: the bridge compiles against the deepseek-harness
  // submodule's source via the base config's paths map, so the bridge and the
  // dsh CLI share one resolution. peerDependencies stay external (bare import
  // specifiers) and resolve from the built tree at runtime.
  "extends": "../../deepseek-harness/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "composite": false,
    "incremental": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src"]
}
