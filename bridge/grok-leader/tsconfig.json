{
  // Out-of-tree build against the published npm dsh packages: the bridge's
  // peers (@deepseek-ai/dsh-* on the ^0.1.0-rc.6 line) install as
  // devDependencies for this tsc build and resolve at runtime from this
  // tree — no deepseek-harness submodule required.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "composite": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
