{
  // Compile against the SDK versions pinned in package.json; the selected
  // DSH installation supplies the runtime implementation.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/dscode/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib/types"
  },
  "include": ["src"]
}
