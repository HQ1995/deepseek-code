#!/usr/bin/env bash
# Legacy source-install shim. The managed launcher provisions this exact
# profile-owned runtime before starting the TUI; never delegate back through
# npx, which can resolve this shim again and recurse indefinitely.
set -euo pipefail

runtime="${DSH_HOME:-$HOME/.dsh}/profiles/dscode/runtime/bin/dsh"
if [[ ! -x "$runtime" ]]; then
  echo "dsh: dscode runtime is missing; repair it with: npx @hqzhao95/dscode@beta" >&2
  exit 1
fi
exec "$runtime" "$@"
