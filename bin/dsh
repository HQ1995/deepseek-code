#!/usr/bin/env bash
# The official npm dsh CLI (never the deepseek-harness submodule build);
# npx on demand. Resolved through npm's global prefix so a stale PATH shim
# cannot win.
DSH_BIN=""
if command -v npm >/dev/null 2>&1; then
  DSH_BIN="$(npm prefix -g 2>/dev/null || true)/bin/dsh"
fi
if [[ -x "$DSH_BIN" ]]; then
  exec "$DSH_BIN" "$@"
fi
exec npx --yes @deepseek-ai/dsh "$@"
